# REITA Backend Environment Variables
# Copy this file to .env and fill in your values.

# MongoDB connection string (keep credentials private — never commit).
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/?appName=YourApp

# JWT signing secret — use a long random string. Never share this.
JWT_SECRET=change_this_to_a_long_random_secret

# Server port.
PORT=5000

# Frontend URL used in email confirmation links.
FRONTEND_URL=https://reita.com.ng

# Resend.com API key — the primary email provider for OTP delivery.
# Sign up at https://resend.com → API Keys → create a key.
# In development you can also use the SMTP fallback below.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Email sender address. Must be a verified domain in Resend.
# For testing without a verified domain, use: REITA <onboarding@resend.dev>
EMAIL_FROM=REITA <onboarding@resend.dev>

# SMTP email delivery (optional fallback — used only if RESEND_API_KEY is not set).
SMTP_HOST=smtp.your-email-provider.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM=REITA <no-reply@reita.app>
